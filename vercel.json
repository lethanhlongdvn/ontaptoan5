{
  "version": 2,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|gif|png|svg|webp|js|css|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=43200"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
